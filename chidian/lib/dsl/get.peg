# === Get DSL ===
#  NOTE: Assume whitespace outside of quoted keys is removed beforehand
get_expr = (array_access / key) ((dot key) / bracket)*
key = (list_op / single / tuple)
array_access = bracket

# === Actionable Units ===
single = name single_index?
list_op = name? multi_index
tuple = lparen nested_expr (comma nested_expr)* rparen

# === Intermediate Representation ===
bracket = single_index / multi_index / quoted_key
single_index = lbrack number rbrack
multi_index = lbrack (star / slice) rbrack
quoted_key = lbrack (dq_string / sq_string) rbrack
slice = number? colon number?
nested_expr = (array_access / key) ((dot key) / bracket)*  # Re-defining so can handle separately

# === Primitives ===
lbrack = "["
rbrack = "]"
lparen = "("
rparen = ")"
comma = ","
colon = ":"
dot = "."
star = "*"

# === Lexemes ===
name = ~"[a-zA-Z_][a-zA-Z0-9_-]*"
number = ~"-?[0-9]+"
dq_string = ~'"[^"]*"'
sq_string = ~"'[^']*'"
